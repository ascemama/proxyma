{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proxyma.local/schemas/proxyma.policy.schema.json",
  "title": "Proxyma Command Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "owner_user_id", "name", "enabled", "rules"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference for editor validation and autocomplete."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Stable Proxyma policy UUID referenced by targets."
    },
    "owner_user_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUID of the user who owns and edits this policy."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable policy name."
    },
    "description": {
      "type": "string",
      "description": "Optional human-readable policy description."
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether Proxyma evaluates this policy."
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "llm": {
      "$ref": "#/$defs/llm",
      "description": "Optional fallback classifier used only when no deterministic rule matches."
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
        "required": ["id", "effect", "command_template"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique rule ID within the policy."
        },
        "effect": {
          "type": "string",
          "enum": ["allow", "deny"],
          "description": "Policy decision returned when the rule matches."
        },
        "command_template": {
          "type": "string",
          "minLength": 1,
          "description": "Whitespace-separated command with typed placeholders such as {ipv4} or {path}."
        },
        "reason": {
          "type": "string",
          "description": "Human-readable reason stored on the task and shown in approval prompts."
        }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "prompt": {
          "type": "string",
          "maxLength": 16384
        }
      }
    }
  }
}

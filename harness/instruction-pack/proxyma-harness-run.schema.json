{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proxyma.local/schemas/proxyma-harness-run.schema.json",
  "title": "ProxymaHarnessRun",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "started_at", "proxyma_base_url", "agent_config", "state_dir", "active_poll_interval_seconds"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "proxyma_base_url": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "examples": ["http://127.0.0.1:8080"]
    },
    "agent_config": {
      "type": "string",
      "minLength": 1,
      "examples": ["harness/agent-configuration/df9ec8bb-1a22-4181-a7c8-126ad553221d.json"]
    },
    "state_dir": { "type": "string", "minLength": 1 },
    "active_poll_interval_seconds": { "type": "integer", "minimum": 1, "default": 30 },
    "pending_tasks_checked": { "type": "integer", "minimum": 0 },
    "new_tasks_created": { "type": "integer", "minimum": 0 },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

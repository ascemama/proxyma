{
  "name": "proxyma-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "docs:toc": "doctoc ../README.md --github",
    "test:e2e": "playwright test",
    "test:e2e:docs": "playwright test e2e/docs-screenshots.spec.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:e2e:visual": "playwright test e2e/visual.spec.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "doctoc": "^2.5.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
